# Copy to .env for local development (npm run dev). On Render, set these in the dashboard.

# Google Gemini (free tier key from https://aistudio.google.com/apikey). Leave empty to use offline suggestions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Each Gemini model has its own free daily quota (Flash: about 20 requests a day; Flash-Lite: hundreds).
# PULSE uses Flash for analysis and Flash-Lite for roleplay replies, and moves to Flash-Lite when Flash runs out.
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# How much the model "thinks" before answering: minimal (fastest), low (default), medium, high, or off.
GEMINI_THINKING=low
AI_REQUESTS_PER_MINUTE=12

# Supabase (Project Settings > API Keys). Leave empty to use the local JSON file with demo data.
# New projects: use the "secret" key (sb_secret_...) and the "publishable" key (sb_publishable_...).
# Older projects can use the legacy service_role and anon keys instead (SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# demo = pick a fictional user (no passwords). supabase = real email/password sign-in.
AUTH_MODE=demo

# Long random string used to sign demo sessions.
APP_SECRET=change-me-to-a-long-random-string

# Comma-separated origins allowed to call the API from another site (your Vercel URL). Empty = only this site.
CORS_ORIGIN=
# Set to false if the web app is hosted on Vercel instead of this server.
SERVE_WEB=true
PORT=3000

# Sessions: sign people out after this many minutes without activity, and this many hours after signing in.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# ---- Security ----
# Bot protection on sign-in (optional): a Cloudflare Turnstile site key. Also turn on CAPTCHA in
# Supabase › Authentication › Settings (Bot and Abuse Protection) with the matching secret key.
# TURNSTILE_SITE_KEY=
# Requests per minute per IP address to the API (default 300). Sign-in and password routes allow 20 per 10 minutes.
# API_REQUESTS_PER_MINUTE=300
# HTTPS only: on automatically on Render. Set to true for other hosts, false to turn it off.
# FORCE_HTTPS=

# ---- AI backups (all optional; each one is used only if its key is set) ----
# Groq: free key at https://console.groq.com/keys (very fast; takes over when Gemini's free quota runs out)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=llama-3.3-70b-versatile
# NVIDIA: free key (nvapi-...) at https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=
# Leave NVIDIA_MODEL unset: PULSE picks a live chat model (NVIDIA retires models often). npm run check-ai shows which one.
# NVIDIA_MODEL=
# Ollama on your own computer: install from https://ollama.com, run "ollama pull qwen3:8b", then set:
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_URL=http://localhost:11434
# Order PULSE tries them in:
# AI_ORDER=gemini,groq,nvidia,ollama
# AI_FAST_ORDER=gemini,groq,nvidia,ollama
