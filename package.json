{
  "name": "pulse",
  "version": "1.0.0",
  "description": "PULSE: AI coaching intelligence for contact center supervisors",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch --env-file-if-exists=.env backend/server.js",
    "test": "node --test tests/*.test.js",
    "reset-demo": "node -e \"require('fs').rmSync('data/local-db.json',{force:true})\"",
    "seed:sql": "node supabase/make-seed.js > supabase/seed.sql",
    "check-ai": "node check-ai.js",
    "create-logins": "node supabase/create-logins.js",
    "import-roster": "node scripts/import-roster.js",
    "doctor": "node scripts/doctor.js",
    "check-secrets": "node scripts/check-secrets.js",
    "audit": "npm audit --omit=dev",
    "security": "npm run check-secrets && npm audit --omit=dev && npm test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.0",
    "cors": "2.8.5",
    "express": "4.22.3"
  }
}
